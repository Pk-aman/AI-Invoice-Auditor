# Root .env — read by docker compose (postgres container + variable substitution)
POSTGRES_DB=auditor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<POSTGRES_ADMIN_PASSWORD>
# Passwords for the least-privilege roles created by infra/postgres/init/01_schemas_roles.sql
# (must match the DATABASE_URLs in agent-service/.env and ai-auditor-services/.env)
AGENT_DB_PASSWORD=<AGENT_DB_PASSWORD>
SERVICES_DB_PASSWORD=<SERVICES_DB_PASSWORD>
