# agent-service environment
LOG_LEVEL=INFO
APP_ENV=dev

DATABASE_URL=postgresql://agent_rw:<AGENT_DB_PASSWORD>@postgres:5432/auditor
ERP_BASE_URL=http://mock-erp:8000
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=invoices
REDIS_URL=redis://redis:6379/0
LLM_CACHE_TTL_S=86400

# --- LLM (Amazon Nova Lite via AWS Bedrock, through LiteLLM) ---
LLM_REASONING_MODEL=bedrock/amazon.nova-lite-v1:0
LLM_TRANSLATION_MODEL=bedrock/amazon.nova-lite-v1:0
LLM_GENERATION_MODEL=bedrock/amazon.nova-lite-v1:0
# Embeddings: Nova Lite does not embed; Titan Text Embeddings v2 (1024-d)
EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60
# --- AWS credentials (fill in; never commit .env) ---
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
# AWS_SESSION_TOKEN=            # only for temporary credentials
AWS_REGION_NAME=us-east-1
# --- Ollama fallback (local dev without AWS): set the models above to e.g. ollama/qwen2.5:7b-instruct ---
OLLAMA_BASE_URL=http://host.docker.internal:11434

RULES_PATH=/config/rules.yaml
INCOMING_DIR=/data/incoming
REPORTS_DIR=/data/reports
# Tesseract packs installed in the image (eng, spa, deu, fra; vie kept for the Vietnamese sample)
OCR_LANGS=eng+spa+deu+fra+vie
POLL_INTERVAL_S=5
PROCESSING_CONCURRENCY=1
RAG_REFLECTION=on

# --- human-in-the-loop review -----------------------------------------------------------------
# reject_and_revalidate rounds allowed; the next one auto-finalizes as SKIPPED_MAX_RETRIES
MAX_HUMAN_CHECKS=3
# seconds a concurrent review of the same invoice waits for the first one to finish
REVIEW_LOCK_TIMEOUT_S=300
# optional comma-separated allow-list of reviewer names (empty = any valid name)
REVIEWERS_ALLOWED=

# --- RAG cache + RAGAS quality thresholds -------------------------------------------------------
RAG_CACHE_TTL_S=3600
RAGAS_MIN_CONTEXT_RELEVANCE=0.7
RAGAS_MIN_FAITHFULNESS=0.7
RAGAS_MIN_ANSWER_RELEVANCE=0.7
RAGAS_TIMEOUT_S=180
# --- RAG retrieval / reranking / retry ---------------------------------------------------------
RAG_TOP_K=10                # RETRIEVAL_K: chunks fetched from Qdrant (+5 per retry)
RAG_FINAL_CONTEXT_K=4       # FINAL_CONTEXT_K: chunks kept after the LLM reranks them
RAG_MAX_RETRIES=1           # MAX_RETRIES: retries when a RAGAS score is below its threshold

# --- LangFuse observability (optional; leave disabled to run without it) --------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
